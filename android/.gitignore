gradle-wrapper.jar
/.gradle
/captures/
/gradlew
/gradlew.bat
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Other local keystores stay ignored. This private repo tracks the SCR7PT
# release key on purpose so the OAuth SHA-1 does not change between builds:
# key.properties and app/keystore/scr7pt-release.jks
**/*.keystore
**/*.jks
!app/keystore/scr7pt-release.jks
